		document.querySelectorAll('.menu button').forEach(button => button.addEventListener('click', () => { document.querySelectorAll('.menu button').forEach(item => item.classList.remove('active')); button.classList.add('active'); document.querySelector('#page-title').textContent = button.dataset.view === 'ホーム' ? 'みんなのおすすめ' : button.dataset.view; }));
