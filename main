		function renderRanking(key) {
			const list = document.querySelector('#ranking-list');
			const items = rankingData[key] || rankingData.overall;
			list.innerHTML = items.map((item, index) => `
				<li class="rank-item">
					<div class="rank-number">${index + 1}</div>
					<div class="rank-main">
						<strong>${item.name}</strong>
						<div class="rank-meta">
							<span>${item.genre}</span>
							<span>・</span>
							<span>${item.area}</span>
						</div>
					</div>
					<div class="rank-score">
						<span>★ ${item.score.toFixed(1)}</span>
						<small>${item.reviews}</small>
					</div>
				</li>
			`).join('');
		}

		function bindReactions(scope = document) { scope.querySelectorAll('.like').forEach(button => button.onclick = () => { button.classList.toggle('liked'); button.querySelector('span').textContent = button.classList.contains('liked') ? '♥' : '♡'; }); scope.querySelectorAll('.bookmark').forEach(button => button.onclick = () => { button.classList.toggle('saved'); button.querySelector('em').textContent = button.classList.contains('saved') ? '保存済み' : '保存'; }); }
		bindReactions();
		renderRanking('overall');
		document.querySelectorAll('.ranking-tab').forEach(tab => tab.addEventListener('click', () => {
			document.querySelectorAll('.ranking-tab').forEach(item => {
				item.classList.toggle('active', item === tab);
				item.setAttribute('aria-selected', String(item === tab));
			});
			renderRanking(tab.dataset.ranking);
		}));
		document.querySelectorAll('.topic').forEach(topic => topic.addEventListener('click', () => { document.querySelectorAll('.topic').forEach(item => item.classList.remove('selected')); topic.classList.add('selected'); }));
